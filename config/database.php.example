<?php
declare(strict_types=1);

/**
 * Example secure PDO database connection.
 * Copy this file to config/database.php on your server and configure environment
 * variables. Never commit real passwords or API keys.
 *
 * Required environment variables:
 * DB_HOST, DB_NAME, DB_USER, DB_PASSWORD
 */

$host = getenv('DB_HOST') ?: '127.0.0.1';
$name = getenv('DB_NAME') ?: '';
$user = getenv('DB_USER') ?: '';
$password = getenv('DB_PASSWORD');

if ($name === '' || $user === '' || $password === false) {
    throw new RuntimeException('Database environment variables are not configured.');
}

$dsn = sprintf('mysql:host=%s;dbname=%s;charset=utf8mb4', $host, $name);

return new PDO($dsn, $user, $password, [
    PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES => false,
    PDO::ATTR_STRINGIFY_FETCHES => false,
]);
